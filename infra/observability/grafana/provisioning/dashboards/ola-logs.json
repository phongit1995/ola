          },
          "expr": "sum(count_over_time({env=\"$env\",service=~\"${service:regex}\",level=\"access\"} | regexp `\\| *(?P<status>\\d{3}) *\\| *(?P<latency>\\S+) *\\| *(?P<ip>\\S+) *\\| *(?P<method>[A-Z]+) +\"(?P<path>[^\"?]*)` | path!=\"/api/v1/health\" | status=~\"2..|3..\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "2xx-3xx",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({env=\"$env\",service=~\"${service:regex}\",level=\"access\"} | regexp `\\| *(?P<status>\\d{3}) *\\| *(?P<latency>\\S+) *\\| *(?P<ip>\\S+) *\\| *(?P<method>[A-Z]+) +\"(?P<path>[^\"?]*)` | path!=\"/api/v1/health\" | status=~\"4..\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "4xx",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({env=\"$env\",service=~\"${service:regex}\",level=\"access\"} | regexp `\\| *(?P<status>\\d{3}) *\\| *(?P<latency>\\S+) *\\| *(?P<ip>\\S+) *\\| *(?P<method>[A-Z]+) +\"(?P<path>[^\"?]*)` | path!=\"/api/v1/health\" | status=~\"5..\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "5xx",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx-3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
