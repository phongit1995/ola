# Copy file này thành deploy.env rồi điền giá trị thật.
# deploy.env đã được .gitignore (KHÔNG commit vì chứa mật khẩu).

SSH_HOST=phong.local
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your-password-here

# Tùy chọn (có default trong deploy.sh):
# IMAGE=phongit1995/ola-web
# TAG=latest
# CONTAINER=ola-web
# HOST_PORT=5081
# NETWORK=dockflare-internal
# DOMAIN=web.ola-server.click
# DOCKFLARE_SERVICE=http://phong.local:5081
