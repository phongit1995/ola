<?xml version="1.0" encoding="utf-8"?>
<set android:repeatCount="infinite" android:repeatMode="restart"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:interpolator="@android:anim/accelerate_interpolator" android:duration="150" android:fromAlpha="0.3" android:toAlpha="1.0" />
    <set android:startOffset="150">
        <translate android:interpolator="@android:anim/accelerate_decelerate_interpolator" android:duration="2000" android:fromXDelta="100.0%" android:toXDelta="500.0%" />
        <alpha android:interpolator="@android:anim/accelerate_interpolator" android:duration="2000" android:fromAlpha="1.0" android:toAlpha="0.3" />
    </set>
</set>
