<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <padding android:left="3.0dp" android:top="3.0dp" android:right="3.0dp" android:bottom="3.0dp" />
            <corners android:radius="4.0dp" />
            <solid android:color="#32545452" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <padding android:left="3.0dp" android:top="3.0dp" android:right="3.0dp" android:bottom="3.0dp" />
            <solid android:color="#28000000" />
            <corners android:radius="4.0dp" />
            <stroke android:width="1.0px" android:color="#64b6bdcb" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="false">
        <shape>
            <padding android:left="3.0dp" android:top="3.0dp" android:right="3.0dp" android:bottom="3.0dp" />
            <solid android:color="#28000000" />
            <corners android:radius="4.0dp" />
            <stroke android:width="2.0px" android:color="#64e1e5a3" />
        </shape>
    </item>
</selector>
