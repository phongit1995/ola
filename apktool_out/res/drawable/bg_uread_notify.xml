        <shape>
            <corners android:radius="@dimen/text.size.caption" />
            <solid android:color="@color/colorTextBlackDivider" />
        </shape>
    </item>
    <item android:left="1.0px" android:top="1.0px" android:right="1.0px" android:bottom="2.0px">
