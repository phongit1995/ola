            <size android:height="@dimen/text.size.subhead" android:width="@dimen/text.size.subhead" />
            <corners android:radius="@dimen/text.size.caption" />
            <padding android:left="8.0dp" android:top="1.0dp" android:right="8.0dp" android:bottom="2.0dp" />
            <solid android:color="@color/colorOlaAccent" />
            <stroke android:width="2.0dp" android:color="@color/colorTextWhitePrimary" />
        </shape>
    </item>
