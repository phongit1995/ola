{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "codegenConfig": {
    "name": "OlaNativeSpec",
    "type": "all",
    "jsSrcsDir": "src/components/specs",
    "android": {
      "javaPackageName": "com.olachat.net.org.vn.richtext"
    },
    "ios": {
      "componentProvider": {
        "OlaRichTextView": "OlaRichTextView",
        "OlaChatComposer": "OlaChatComposerView"
      },
      "modulesProvider": {
        "OlaRichText": "NativeOlaRichText"
      }
    }
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "echo .env > /tmp/envfile && react-native run-ios --scheme OlaMobile",
    "ios:prod": "echo env.production > /tmp/envfile && react-native run-ios --scheme OlaMobile-Prod --mode Release",
    "lint": "eslint .",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "cd .. && patch-package --patch-dir mobile/patches"
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@d11/react-native-fast-image": "^8.13.0",
    "@livekit/components-react": "^2.9.23",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@ola/shared": "workspace:*",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/crashlytics": "^25.1.0",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.3.5",
    "@react-navigation/native-stack": "^7.3.10",
    "@shopify/flash-list": "^2.3.2",
    "axios": "^1.17.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.1",
    "livekit-client": "^2.21.0",
    "nativewind": "^4.2.6",
    "react": "^19.2.3",
