+/**
+ * A TurboModule Callback may only be invoked once. On the New Architecture a
+ * second invocation hits `LOG(FATAL) << "Callback arg cannot be called more
+ * than once"` in JavaTurboModule.cpp, which aborts the process. That is not a
+ * Java exception, so the try/catch this module used to rely on cannot stop it.
+ *
+ * onPrepared/onError and onCompletion/onError are distinct listener objects
+ * sharing one Callback, so the "already called" flag has to live with the
+ * Callback, not with each listener.
+ */
+private class SingleShotCallback(private var callback: Callback?) {
+  @Synchronized
+  fun invoke(vararg args: Any?) {
+    val target = callback ?: return
+    callback = null
+    target.invoke(*args)
+  }
+}
