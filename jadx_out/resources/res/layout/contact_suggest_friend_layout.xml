<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/translucent_white_80_percent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/metric.16dp"
        android:paddingTop="@dimen/metric.8dp"
        android:paddingRight="@dimen/metric.16dp"
        android:paddingBottom="@dimen/metric.8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:padding="0dp"
            android:layout_width="@dimen/contact.item.avatar.size"
            android:layout_height="@dimen/contact.item.avatar.size"
            android:src="@drawable/ic_tab_find_friend"
            android:scaleType="centerInside"
            android:cropToPadding="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.8dp"
            android:layout_weight="1">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/string_may_be_you_want_to_make_friend"
                android:maxLines="1"
                style="@style/defaultStyle.text.subhead"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/contact.item.avatar.size"
                android:layout_marginTop="@dimen/metric.8dp">
                <chat.ola.vn.view.OlaCachedImageView
                    android:id="@+id/profilePicImageView1"
                    android:padding="0dp"
                    android:focusable="false"
                    android:visibility="visible"
                    android:layout_width="@dimen/contact.item.avatar.size"
                    android:layout_height="@dimen/contact.item.avatar.size"
                    android:src="@drawable/ic_contact_photo"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
                <chat.ola.vn.view.OlaCachedImageView
                    android:id="@+id/profilePicImageView2"
                    android:padding="0dp"
                    android:focusable="false"
                    android:visibility="visible"
                    android:layout_width="@dimen/contact.item.avatar.size"
                    android:layout_height="@dimen/contact.item.avatar.size"
                    android:layout_marginLeft="@dimen/metric.16dp"
                    android:src="@drawable/ic_contact_photo"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
                <chat.ola.vn.view.OlaCachedImageView
                    android:id="@+id/profilePicImageView3"
                    android:padding="0dp"
                    android:focusable="false"
                    android:visibility="visible"
                    android:layout_width="@dimen/contact.item.avatar.size"
                    android:layout_height="@dimen/contact.item.avatar.size"
                    android:layout_marginLeft="@dimen/metric.16dp"
                    android:src="@drawable/ic_contact_photo"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/numberPhoneFriendTextView"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.8dp"
            android:text="123"
            style="@style/defaultStyle.contact.text.unread"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.8dp"
            android:src="@drawable/ic_arrow_right"/>
    </LinearLayout>
    <View
        android:id="@+id/listViewBottomDividerView"
        android:background="@color/colorTextBlackDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/metric.16dp"
        android:layout_marginRight="@dimen/metric.16dp"/>
</LinearLayout>
