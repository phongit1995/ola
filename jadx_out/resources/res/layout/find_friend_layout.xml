<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/actionBarSpan"
        android:background="@drawable/bg_action_bar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric.48dp">
        <TextView
            android:id="@+id/btnTabSuggestedFriends"
            android:padding="@dimen/metric.2dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/string_suggest"
            style="@style/defaultStyle.actionBar.tab"/>
        <View
            android:background="#32b2b2b2"
            android:layout_width="1px"
            android:layout_height="24dp"/>
        <TextView
            android:id="@+id/btnTabFindFriendsFromContact"
            android:padding="@dimen/metric.2dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/string_contacts"
            style="@style/defaultStyle.actionBar.tab"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/metric.48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_action_quit"
            style="?attr/actionBar.button"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="@dimen/general.dialog.width.max"
        android:layout_weight="1">
        <android.support.v4.view.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/defaultStyle.progresswatting"/>
    </FrameLayout>
    <include layout="@layout/button_invite_friend_layout"/>
</LinearLayout>
