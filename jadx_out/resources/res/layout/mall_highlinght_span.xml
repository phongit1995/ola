<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <chat.ola.vn.view.RatioFrameLayout
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/metric.4dp">
        <com.mg.ola.common.widget.OlaViewPager
            android:id="@+id/viewpagerMallConver"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.mg.ola.common.pager.indicator.CirclePageIndicator
            android:layout_gravity="bottom|right"
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/metric.4dp"/>
    </chat.ola.vn.view.RatioFrameLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/linearPageTabSpan"
        android:background="#2b2b2b"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@color/text_color_1"
        android:minHeight="@dimen/general.list.item.height.small"
        android:dividerPadding="@dimen/metric.4dp"/>
</LinearLayout>
