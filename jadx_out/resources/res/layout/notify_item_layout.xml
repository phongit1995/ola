<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/translucent_white_80_percent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="top"
        android:padding="@dimen/metric.16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/metric.72dp">
        <chat.ola.vn.view.OlaCachedImageView
            android:id="@+id/imgIcon"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="@dimen/metric.40dp"
            android:layout_height="@dimen/metric.40dp"
            android:scaleType="centerCrop"
            android:cropToPadding="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.16dp"
            android:layout_weight="1">
            <TextView
                android:ellipsize="end"
                android:id="@+id/txtSender"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/defaultStyle.text.subhead"/>
            <TextView
                android:id="@+id/txtTitle"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.4dp"
                android:maxLines="3"
                android:lineSpacingMultiplier="1"
                style="@style/defaultStyle.text.body1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/notificationButtonLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.4dp">
                <Button
                    android:textColor="@color/white"
                    android:layout_gravity="bottom"
                    android:id="@+id/notificationButton1"
                    android:background="@drawable/btn_green_button_selector"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/metric.28dp"
                    android:minWidth="@dimen/metric.64dp"
                    android:text="@string/string_agree"
                    android:layout_weight="1"
                    style="?attr/me.item.button"/>
                <Button
                    android:layout_gravity="bottom"
                    android:id="@+id/notificationButton2"
                    android:background="@drawable/btn_default_button_selector"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/metric.28dp"
                    android:layout_marginLeft="@dimen/metric.8dp"
                    android:minWidth="@dimen/metric.64dp"
                    android:text="@string/string_no"
                    android:layout_weight="1"
                    style="?attr/me.item.button"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.4dp">
                <ImageView
                    android:id="@+id/iconImageView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/metric.20dp"
                    android:layout_marginRight="@dimen/metric.4dp"
                    android:src="@drawable/ic_like_selected"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"/>
                <TextView
                    android:id="@+id/txtTimeLable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/defaultStyle.text.caption"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/listViewBottomDividerView"
        android:background="@color/colorTextBlackDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/metric.16dp"
        android:layout_marginRight="@dimen/metric.16dp"/>
</LinearLayout>
