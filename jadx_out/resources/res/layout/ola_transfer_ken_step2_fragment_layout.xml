<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/metric.16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/colorTextBlackSecondaryOrIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp"
        android:text="@string/string_receiver"
        style="@style/defaultStyle.text.subhead"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric.48dp"
        android:layout_marginTop="@dimen/metric.8dp">
        <chat.ola.vn.view.OlaCachedImageView
            android:id="@+id/receiverProfileImageView"
            android:padding="0dp"
            android:focusable="false"
            android:layout_width="@dimen/metric.48dp"
            android:layout_height="@dimen/metric.48dp"
            android:src="@drawable/ic_contact_photo"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/metric.16dp"
            android:layout_toRightOf="@+id/receiverProfileImageView"
            android:layout_alignParentTop="true">
            <TextView
                android:ellipsize="end"
                android:id="@+id/receiverNickTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/defaultStyle.text.subhead"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/receiverFullnameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.2dp"
                android:maxLines="1"
                style="@style/defaultStyle.text.caption"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textColor="@color/colorTextBlackSecondaryOrIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp"
        android:text="@string/string_transferred_ken_amount"
        style="@style/defaultStyle.text.subhead"/>
    <TextView
        android:id="@+id/kenAmountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.8dp"
        style="@style/defaultStyle.text.title"/>
    <View
        android:background="@color/colorTextBlackDivider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/metric.16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/txtTransferPasswordViewLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_password"
            style="@style/defaultStyle.text.subhead"/>
        <EditText
            android:id="@+id/transferKenPasswordEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/general_hint_ken_transfer_password"
            android:maxLines="1"
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            style="@style/defaultStyle.edittext"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.24dp">
        <Button
            android:gravity="center"
            android:id="@+id/editButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/metric.36dp"
            android:layout_marginRight="@dimen/metric.4dp"
            android:text="@string/string_edit"
            android:layout_weight="1"
            style="@style/defaultStyle.button"/>
        <Button
            android:gravity="center"
            android:id="@+id/transferButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/metric.36dp"
            android:layout_marginLeft="@dimen/metric.4dp"
            android:text="@string/string_ok"
            android:layout_weight="1"
            style="@style/defaultStyle.button.green"/>
    </LinearLayout>
</LinearLayout>
