<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <GridView
        android:id="@+id/albumGridView"
        android:paddingLeft="@dimen/metric.8dp"
        android:paddingTop="@dimen/metric.56dp"
        android:paddingRight="@dimen/metric.8dp"
        android:paddingBottom="@dimen/metric.16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:horizontalSpacing="@dimen/metric.4dp"
        android:verticalSpacing="@dimen/metric.8dp"
        android:numColumns="3"
        style="@style/defaultStyle.list.noDivider"/>
    <FrameLayout
        android:id="@+id/darkLayerLayout"
        android:background="@color/translucent_black_38_percent"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/wattingProgressBar"
            android:layout_width="@dimen/metric.48dp"
            android:layout_height="@dimen/metric.48dp"/>
    </FrameLayout>
    <ListView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/albumChooserListView"
        android:background="@drawable/bg_shadow_top_arrow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.64dp"
        style="@style/defaultStyle.list.noDivider"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/olaTopActionBarViewLayout"
        android:layout_width="match_parent"
        style="@style/defaultStyle.actionBar.background">
        <ImageView
            android:id="@+id/cameraImageView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_action_camera_white"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/olaActionBarTitleViewLayout"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/metric.2dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/metric.8dp"
            android:layout_marginRight="@dimen/metric.8dp"
            android:layout_weight="1">
            <TextView
                android:textColor="@color/colorTextWhitePrimary"
                android:ellipsize="end"
                android:id="@+id/olaActionBarTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/defaultStyle.text.button"/>
            <TextView
                android:textColor="@color/colorTextWhiteSecondary"
                android:ellipsize="end"
                android:id="@+id/olaActionBarSubTitleTextView"
                android:padding="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/string_tap_to_select_album"
                android:maxLines="1"
                style="@style/defaultStyle.text.caption"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/colorTextWhitePrimary"
            android:gravity="center"
            android:id="@+id/olaActionBarButtonTextView"
            android:padding="@dimen/metric.8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/metric.48dp"
            android:text="@string/string_done"
            style="@style/defaultStyle.text.button"/>
    </LinearLayout>
</FrameLayout>
