<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_shadown_border"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="top|left"
            android:orientation="vertical"
            android:padding="@dimen/metric.8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/txtMeOwnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <chat.ola.vn.view.OlaCachedImageView
                    android:id="@+id/attachedMeCommentOvatar"
                    android:focusable="false"
                    android:layout_width="@dimen/metric.36dp"
                    android:layout_height="@dimen/metric.36dp"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/attachedMeCommentNick"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/metric.8dp"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/defaultStyle.text.subhead"/>
            </LinearLayout>
            <TextView
                android:ellipsize="end"
                android:gravity="top|left"
                android:layout_gravity="top|left"
                android:id="@+id/attachedMeCommentContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.8dp"
                android:maxLines="4"
                style="@style/defaultStyle.text.body1"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/attachedMeCommentMediaPan"
            android:background="@drawable/bg_stroke_border_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <chat.ola.vn.view.OlaRatioImageView
                android:id="@+id/attachedMeCommentImageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/attachedMeVideoInfo"
                android:background="@color/translucent_black_60_percent"
                android:padding="@dimen/metric.4dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_play_media"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/metric.4dp">
                    <TextView
                        android:textSize="@dimen/text.size.caption"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/meYouTubeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="@dimen/text.size.caption"
                        android:textColor="@color/colorTextWhiteHintOrDisable"
                        android:ellipsize="end"
                        android:layout_gravity="center"
                        android:id="@+id/attachedMeVideoDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/metric.4dp"
                        android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="left"
            android:orientation="horizontal"
            android:padding="@dimen/metric.8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom|left"
                android:id="@+id/attachedMeCommentNumberOfComments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:drawablePadding="@dimen/metric.2dp"
                android:layout_weight="1"
                style="@style/defaultStyle.text.caption"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="bottom|left"
                android:id="@+id/attachedMeCommentNumberOfLike"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/metric.16dp"
                android:maxLines="1"
                android:layout_weight="1"
                style="@style/defaultStyle.text.caption"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/attachedMeCommentLoading"
        android:layout_width="19dp"
        android:layout_height="19dp"
        style="@style/defaultStyle.progresswatting"/>
</FrameLayout>
