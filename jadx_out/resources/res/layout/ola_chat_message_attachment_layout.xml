<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/metric.8dp"
    android:paddingTop="@dimen/metric.2dp"
    android:paddingRight="@dimen/metric.8dp"
    android:paddingBottom="@dimen/metric.2dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/metric.36dp">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/quickReplyImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.2dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_quick_reply_gray"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/chatTextSmileyImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.2dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/btn_smiley_selector"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/kulImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.2dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/btn_kul_selector"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/cameraImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.2dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/btn_camera_selector"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/localPhotoImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/btn_local_photo_selector"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/voiceImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/btn_voice_selector"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/moreImageButton"
        android:background="@color/transparent"
        android:padding="@dimen/metric.4dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@drawable/btn_more_selector"
        android:scaleType="centerInside"
        android:layout_weight="1"/>
</LinearLayout>
