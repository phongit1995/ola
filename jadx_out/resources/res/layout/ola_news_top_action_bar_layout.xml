<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/olaTopActionBarViewLayout"
    android:paddingLeft="@dimen/metric.8dp"
    android:paddingTop="@dimen/metric.4dp"
    android:paddingRight="@dimen/metric.8dp"
    android:paddingBottom="@dimen/metric.10dp"
    android:layout_width="match_parent"
    style="@style/defaultStyle.actionBar.background">
    <ImageView
        android:id="@+id/olaActionBarBackImageView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/metric.8dp"
        android:src="@drawable/ic_action_back"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/defaultStyle.edittext.small.border.light">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/metric.16dp"
            android:layout_height="@dimen/metric.16dp"
            android:src="@drawable/ic_action_search_small"
            android:adjustViewBounds="true"/>
        <EditText
            android:textSize="@dimen/text.size.body1"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:layout_gravity="center"
            android:id="@+id/searchNewsEditText"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/metric.4dp"
            android:hint="@string/string_search"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionSearch"
            style="@style/defaultStyle.edittext.nobackground"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/newsActionBarHomeImageView"
        android:padding="@dimen/metric.2dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/metric.8dp"
        android:src="@drawable/ic_action_home"
        android:scaleType="centerInside"/>
    <ImageView
        android:id="@+id/olaActionBarMoreButtonImageView"
        android:padding="@dimen/metric.2dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_more_white"
        android:scaleType="centerInside"
        style="?attr/actionBar.button"/>
</LinearLayout>
