<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ExpandableListView
        android:id="@+id/lvAppConfigList"
        android:paddingTop="@dimen/metric.topbar.noshadow.42dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/metric.16dp"
        android:layout_marginRight="@dimen/metric.16dp"
        android:layout_marginBottom="@dimen/metric.64dp"
        android:groupIndicator="@null"
        style="@style/defaultStyle.list.noDivider"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_white_with_top_border"
        android:padding="@dimen/metric.16dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric.64dp">
        <TextView
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/message_join_us_on_facebook"
            android:maxLines="3"
            android:layout_weight="1"
            style="?attr/me.info.text"/>
        <com.facebook.share.widget.LikeView
            android:layout_gravity="center"
            android:id="@+id/fbLikeView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.16dp"/>
    </LinearLayout>
    <include layout="@layout/ola_top_action_bar_center_title_layout"/>
</FrameLayout>
