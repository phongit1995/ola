<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp">
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number1Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="1"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number2Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="2"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number3Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:text="3"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp">
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number4Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="4"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number5Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="5"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number6Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:text="6"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp">
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number7Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="7"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number8Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="8"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number9Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:text="9"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/metric.16dp">
        <View
            android:visibility="invisible"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginRight="@dimen/metric.12dp"/>
        <Button
            android:textSize="@dimen/text.size.32sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/number0Button"
            android:background="@drawable/btn_passcode_selector"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"
            android:layout_marginRight="@dimen/metric.12dp"
            android:text="0"/>
        <View
            android:visibility="invisible"
            android:layout_width="@dimen/metric.72dp"
            android:layout_height="@dimen/metric.72dp"
            android:layout_marginLeft="@dimen/metric.12dp"/>
    </LinearLayout>
</merge>
