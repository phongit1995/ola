<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/mapWrapper"
        android:paddingTop="@dimen/metric.topbar.noshadow.42dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/mapContentView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <View
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="2px"/>
            <ListView
                android:id="@+id/lvFriendList"
                android:background="@color/white"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:cacheColorHint="@color/transparent"
                android:layout_weight="2"
                style="?attr/commont.list"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btnMyLocation"
            android:background="?attr/commont.button.image.solid"
            android:layout_width="@dimen/metric.36dp"
            android:layout_height="@dimen/metric.36dp"
            android:layout_margin="@dimen/metric.8dp"
            android:src="@drawable/ic_action_my_location"
            android:scaleType="centerInside"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            style="?attr/actionBar.button"/>
        <ImageView
            android:id="@+id/btnFriendList"
            android:background="?attr/commont.button.image.solid"
            android:layout_width="@dimen/metric.36dp"
            android:layout_height="@dimen/metric.36dp"
            android:layout_margin="@dimen/metric.8dp"
            android:src="@drawable/ic_action_friend_list"
            android:scaleType="centerInside"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            style="?attr/actionBar.button"/>
    </RelativeLayout>
    <include layout="@layout/ola_top_icon_action_bar_layout"/>
</FrameLayout>
