<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mallDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:paddingTop="@dimen/metric.topbar.noshadow.42dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/mall_content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/mallWatting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/defaultStyle.progresswatting"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/actionBarSpan"
            android:layout_width="match_parent"
            style="@style/defaultStyle.actionBar.background">
            <LinearLayout
                android:id="@+id/actionBarIconSpan"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/metric.4dp">
                <ImageView
                    android:id="@+id/imgActionBackIndicate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/metric.8dp"
                    android:layout_marginBottom="@dimen/metric.8dp"
                    android:src="@drawable/ic_action_back"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/metric.4dp"
                    android:layout_marginTop="@dimen/metric.8dp"
                    android:layout_marginBottom="@dimen/metric.8dp"
                    android:src="@drawable/ic_tab_appstore"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"/>
            </LinearLayout>
            <chat.ola.vn.view.AutoScrollTextView
                android:id="@+id/txtMallActionTitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/metric.8dp"
                android:text="@string/general_tab_ola_mall"
                android:layout_weight="1"
                style="?attr/actionBar.title"/>
            <LinearLayout
                android:gravity="bottom|center_horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/btnMallActionTag"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:padding="@dimen/metric.4dp"
                    android:layout_width="@dimen/metric.48dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_tab_mall_tag"
                    android:scaleType="centerInside"
                    style="?attr/actionBar.tab.button"/>
                <ImageView
                    android:id="@+id/btnMallActionNew"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:padding="@dimen/metric.4dp"
                    android:layout_width="@dimen/metric.48dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_tab_mall_new"
                    android:scaleType="centerInside"
                    style="?attr/actionBar.tab.button"/>
                <ImageView
                    android:id="@+id/btnMallActionHot"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:padding="@dimen/metric.4dp"
                    android:layout_width="@dimen/metric.48dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_tab_mall_hot"
                    android:scaleType="centerInside"
                    style="?attr/actionBar.tab.button"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/mallAction1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_action_share"
                style="?attr/actionBar.button"/>
            <ImageView
                android:id="@+id/actionButtonMore"
                android:layout_width="@dimen/metric.36dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_more_white"
                style="?attr/actionBar.button"/>
            <ImageView
                android:id="@+id/actionButtonClose"
                android:padding="@dimen/metric.8dp"
                android:layout_width="@dimen/metric.48dp"
                android:layout_height="@dimen/metric.36dp"
                android:src="@drawable/ic_action_quit"
                android:scaleType="centerInside"
                style="?attr/commont.button.image"/>
        </LinearLayout>
    </FrameLayout>
    <RelativeLayout
        android:layout_gravity="left"
        android:id="@+id/left_drawer"
        android:background="@drawable/drawer_left_shadow"
        android:layout_width="240dp"
        android:layout_height="match_parent">
        <ListView
            android:id="@+id/lvSliderList"
            android:paddingRight="0dp"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@color/transparent"
            android:divider="#1e1e1e"
            android:dividerHeight="1dp"
            style="?attr/commont.list"/>
    </RelativeLayout>
</android.support.v4.widget.DrawerLayout>
