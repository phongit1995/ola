<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/wvContent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/metric.topbar.noshadow.42dp"/>
    <ImageButton
        android:layout_gravity="bottom|right"
        android:id="@+id/editImageButton"
        android:background="@drawable/floating_action_bar_shape"
        android:padding="@dimen/metric.16dp"
        android:visibility="gone"
        android:layout_width="@dimen/metric.56dp"
        android:layout_height="@dimen/metric.56dp"
        android:layout_marginRight="@dimen/metric.16dp"
        android:layout_marginBottom="@dimen/metric.16dp"
        android:src="@drawable/ic_action_edit"
        android:scaleType="centerInside"
        android:tint="@android:color/white"/>
    <include
        android:id="@+id/linearWrap"
        layout="@layout/ola_top_icon_action_bar_layout"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/defaultStyle.progresswatting"/>
</FrameLayout>
