<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="false"
        android:state_pressed="false">
        <shape>
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#6bc1dd"
                android:endColor="#aae6fd"
                android:angle="90"/>
            <padding
                android:left="@dimen/metric.2dp"
                android:top="@dimen/metric.2dp"
                android:right="@dimen/metric.2dp"
                android:bottom="@dimen/metric.2dp"/>
            <stroke
                android:width="1px"
                android:color="#6bb4f3"/>
        </shape>
    </item>
    <item
        android:state_focused="false"
        android:state_pressed="true">
        <shape>
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#6bc1dd"
                android:endColor="#aae6fd"
                android:angle="270"/>
            <padding
                android:left="@dimen/metric.2dp"
                android:top="@dimen/metric.2dp"
                android:right="@dimen/metric.2dp"
                android:bottom="@dimen/metric.2dp"/>
            <stroke
                android:width="1px"
                android:color="#6bb4f3"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_pressed="false">
        <shape>
            <corners android:radius="10dp"/>
            <gradient
                android:startColor="#6bc1dd"
                android:endColor="#aae6fd"
                android:angle="90"/>
            <padding
                android:left="@dimen/metric.2dp"
                android:top="@dimen/metric.2dp"
                android:right="@dimen/metric.2dp"
                android:bottom="@dimen/metric.2dp"/>
            <stroke
                android:width="2px"
                android:color="#6bb4f3"/>
        </shape>
    </item>
</selector>
