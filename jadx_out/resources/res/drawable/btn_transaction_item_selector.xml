<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="false"
        android:drawable="@color/transparent"/>
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#a6fafc"
                android:endColor="#4996fe"
                android:angle="270"
                android:centerColor="#75c6fd"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
</selector>
