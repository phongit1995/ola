<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-1px"
        android:top="0px"
        android:right="-1px"
        android:bottom="-1px">
        <shape>
            <padding
                android:left="@dimen/metric.2dp"
                android:top="@dimen/metric.2dp"
                android:right="@dimen/metric.2dp"
                android:bottom="@dimen/metric.2dp"/>
            <stroke
                android:width="1px"
                android:color="#32ffffff"/>
            <gradient
                android:startColor="#636363"
                android:endColor="#252525"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
