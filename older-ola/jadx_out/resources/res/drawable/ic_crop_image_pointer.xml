<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp"/>
            <solid android:color="#40000000"/>
        </shape>
    </item>
    <item
        android:left="1px"
        android:top="1px"
        android:right="1px"
        android:bottom="2px">
        <shape android:shape="rectangle">
            <size
                android:height="18sp"
                android:width="18sp"/>
            <corners android:radius="12dp"/>
            <padding
                android:left="4dp"
                android:top="1dp"
                android:right="4dp"
                android:bottom="2dp"/>
            <solid android:color="@color/colorOlaAccent"/>
            <stroke
                android:width="2dp"
                android:color="@color/white"/>
        </shape>
    </item>
</layer-list>
