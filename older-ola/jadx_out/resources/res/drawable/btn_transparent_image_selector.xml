<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="false"
        android:state_pressed="false"
        android:drawable="@color/transparent"/>
    <item
        android:state_focused="false"
        android:state_pressed="true">
        <shape>
            <padding
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp"/>
            <solid android:color="#28000000"/>
            <stroke
                android:width="1px"
                android:color="#64b6bdcb"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_pressed="false">
        <shape>
            <padding
                android:left="3dp"
                android:top="3dp"
                android:right="3dp"
                android:bottom="3dp"/>
            <solid android:color="#28000000"/>
            <stroke
                android:width="2px"
                android:color="#64e1e5a3"/>
        </shape>
    </item>
</selector>
