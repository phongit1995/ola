<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="false"
        android:state_selected="false"
        android:state_pressed="false">
        <shape>
            <solid android:color="@color/white"/>
            <size
                android:height="32dp"
                android:width="10dp"/>
            <stroke
                android:width="1px"
                android:color="@color/colorOlaPrimary"/>
        </shape>
    </item>
    <item
        android:state_focused="false"
        android:state_selected="true"
        android:state_pressed="false">
        <shape>
            <solid android:color="@color/colorOlaPrimary"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_selected="false"
        android:state_pressed="false">
        <shape>
            <solid android:color="@color/white"/>
            <size
                android:height="32dp"
                android:width="10dp"/>
            <stroke
                android:width="2px"
                android:color="@color/colorOlaPrimary"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_selected="true"
        android:state_pressed="false">
        <shape>
            <solid android:color="@color/colorOlaPrimary"/>
            <size
                android:height="32dp"
                android:width="10dp"/>
        </shape>
    </item>
    <item
        android:state_selected="true"
        android:state_pressed="true">
        <shape>
            <solid android:color="@color/colorOlaPrimary"/>
            <size
                android:height="32dp"
                android:width="10dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/white"/>
            <size
                android:height="32dp"
                android:width="10dp"/>
            <stroke
                android:width="1px"
                android:color="@color/colorOlaPrimary"/>
        </shape>
    </item>
</selector>
