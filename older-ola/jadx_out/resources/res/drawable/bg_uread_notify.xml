<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/text.size.caption"/>
            <solid android:color="@color/colorTextBlackDivider"/>
        </shape>
    </item>
    <item
        android:left="1px"
        android:top="1px"
        android:right="1px"
        android:bottom="2px">
        <shape android:shape="rectangle">
            <size
                android:height="@dimen/text.size.subhead"
                android:width="@dimen/text.size.subhead"/>
            <corners android:radius="@dimen/text.size.caption"/>
            <padding
                android:left="8dp"
                android:top="1dp"
                android:right="8dp"
                android:bottom="2dp"/>
            <solid android:color="@color/colorOlaAccent"/>
            <stroke
                android:width="2dp"
                android:color="@color/colorTextWhitePrimary"/>
        </shape>
    </item>
</layer-list>
