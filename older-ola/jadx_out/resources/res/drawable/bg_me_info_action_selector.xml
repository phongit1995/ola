<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="false"
        android:state_pressed="false">
        <shape>
            <padding
                android:left="1px"
                android:top="1px"
                android:right="1px"
                android:bottom="1px"/>
            <solid android:color="#d8dde6"/>
            <stroke
                android:width="1px"
                android:color="#b6bdcb"/>
        </shape>
    </item>
    <item
        android:state_focused="false"
        android:state_pressed="true">
        <shape>
            <padding
                android:left="1px"
                android:top="1px"
                android:right="1px"
                android:bottom="1px"/>
            <solid android:color="#32d8dde6"/>
            <stroke
                android:width="1px"
                android:color="#b6bdcb"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_pressed="false">
        <shape>
            <padding
                android:left="1px"
                android:top="1px"
                android:right="1px"
                android:bottom="1px"/>
            <solid android:color="#32d8dde6"/>
            <stroke
                android:width="2px"
                android:color="#e1e5a3"/>
        </shape>
    </item>
</selector>
