<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/text.size.caption"/>
            <solid android:color="#40000000"/>
        </shape>
    </item>
    <item
        android:left="1px"
        android:top="1px"
        android:right="1px"
        android:bottom="2px">
        <shape android:shape="rectangle">
            <size
                android:height="@dimen/text.size.body1"
                android:width="@dimen/text.size.body1"/>
            <corners android:radius="@dimen/text.size.caption"/>
            <padding
                android:left="@dimen/metric.4dp"
                android:top="@dimen/metric.2dp"
                android:right="@dimen/metric.4dp"
                android:bottom="@dimen/metric.2dp"/>
            <solid android:color="#d70a0a"/>
            <stroke
                android:width="2dp"
                android:color="@color/white"/>
        </shape>
    </item>
</layer-list>
