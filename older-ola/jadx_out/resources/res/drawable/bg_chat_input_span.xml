<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0px"
        android:top="0px"
        android:right="0px"
        android:bottom="0px">
        <shape>
            <solid android:color="#e8e5e5"/>
        </shape>
    </item>
    <item
        android:top="1px"
        android:bottom="0px">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f7f7f7"
                android:endColor="#e1e1e1"
                android:angle="270"/>
            <padding
                android:left="@dimen/metric.2dp"
                android:top="@dimen/metric.2dp"
                android:right="@dimen/metric.2dp"
                android:bottom="@dimen/metric.2dp"/>
        </shape>
    </item>
</layer-list>
