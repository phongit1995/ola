<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:paddingTop="@dimen/metric.topbar.noshadow.42dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <android.support.v4.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <chat.ola.vn.view.OlaListView
                    android:id="@+id/listView"
                    android:paddingLeft="0dp"
                    android:paddingRight="0dp"
                    android:paddingBottom="0dp"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/defaultStyle.list.rowSpacing"/>
            </android.support.v4.widget.SwipeRefreshLayout>
            <include
                android:id="@+id/stubBlankContent"
                android:visibility="gone"
                layout="@layout/blank_page_layout"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/meWattingProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/defaultStyle.progresswatting"/>
            <ImageButton
                android:layout_gravity="bottom|right"
                android:id="@+id/writeStatusImageButton"
                android:background="@drawable/floating_action_bar_shape"
                android:padding="@dimen/metric.16dp"
                android:layout_width="@dimen/metric.56dp"
                android:layout_height="@dimen/metric.56dp"
                android:layout_marginRight="@dimen/metric.16dp"
                android:layout_marginBottom="@dimen/metric.16dp"
                android:src="@drawable/ic_action_edit"
                android:scaleType="centerInside"
                android:tint="@android:color/white"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/stickyHeader"
            android:clickable="true"
            android:layout_width="match_parent"
            style="@style/defaultStyle.actionBar.background">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/linearQuickButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/metric.32dp"
                android:layout_marginRight="@dimen/metric.32dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="@dimen/metric.48dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/btnHomePage"
                        android:background="@drawable/btn_transparent_image_selector"
                        android:padding="@dimen/metric.8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_action_tab_ola"
                        android:scaleType="centerInside"
                        android:adjustViewBounds="true"
                        style="?attr/actionBar.tab.button"/>
                    <TextView
                        android:layout_gravity="top|right"
                        android:id="@+id/txtNewMeNotify"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="?attr/commont.text.unread"/>
                </FrameLayout>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/btnReplyMe"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:padding="@dimen/metric.8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/metric.4dp"
                    android:src="@drawable/ic_action_tab_tag"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:minWidth="@dimen/metric.48dp"
                    style="?attr/actionBar.tab.button"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/btnMediaMe"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:padding="@dimen/metric.8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/metric.4dp"
                    android:src="@drawable/ic_action_tab_media"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:minWidth="@dimen/metric.48dp"
                    style="?attr/actionBar.tab.button"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/buttonFollowerImageView"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:padding="@dimen/metric.8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/metric.4dp"
                    android:src="@drawable/ic_action_tab_follower"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:minWidth="@dimen/metric.48dp"
                    style="?attr/actionBar.tab.button"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text.size.body1"
            android:textColor="@color/colorOlaPrimaryDark"
            android:gravity="center"
            android:id="@+id/txtNewUnreadMeInfo"
            android:background="@drawable/bg_unread_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/stickyHeader"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <chat.ola.vn.view.OlaListView
        android:layout_gravity="left"
        android:id="@+id/left_drawer"
        android:background="@color/white"
        android:scrollbars="none"
        android:layout_width="@dimen/metric.240dp"
        android:layout_height="match_parent"
        android:divider="@color/colorTextBlackDivider"
        android:dividerHeight="1dp"
        style="?attr/commont.list"/>
    <chat.ola.vn.view.OlaListView
        android:layout_gravity="right"
        android:id="@+id/right_drawer"
        android:background="@color/white"
        android:scrollbars="none"
        android:layout_width="@dimen/metric.240dp"
        android:layout_height="match_parent"
        android:divider="@color/colorTextBlackDivider"
        android:dividerHeight="1dp"/>
</android.support.v4.widget.DrawerLayout>
