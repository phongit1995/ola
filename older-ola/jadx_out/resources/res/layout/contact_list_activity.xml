<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/actionBarSpan"
        android:background="@drawable/bg_action_bar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric.48dp">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.8dp"
            android:layout_marginTop="@dimen/metric.8dp"
            android:layout_marginRight="@dimen/metric.2dp"
            android:layout_marginBottom="@dimen/metric.8dp"
            android:src="@drawable/ic_action_back"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.8dp"
            android:layout_marginRight="@dimen/metric.8dp"
            android:layout_marginBottom="@dimen/metric.8dp"
            android:src="@drawable/app_icon"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/txtActionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/string_invite_friend"
            android:maxLines="1"
            android:layout_weight="1"
            style="?attr/actionBar.title"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/numberActionWrap"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/metric.8dp">
            <Button
                android:textSize="@dimen/text.size.caption"
                android:textColor="@color/text_color_7"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/btnNumberAction"
                android:background="@drawable/btn_default_button_selector"
                android:paddingLeft="@dimen/metric.4dp"
                android:paddingRight="@dimen/metric.4dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/metric.36dp"
                android:text="@string/invite"
                android:maxLines="1"/>
            <TextView
                android:layout_gravity="top|right"
                android:id="@+id/numberActionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:text="1"
                style="?attr/commont.text.unread"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:layout_gravity="center"
            android:id="@+id/editSearch"
            android:background="@drawable/bg_edittext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.4dp"
            android:layout_marginRight="@dimen/metric.4dp"
            android:hint="@string/string_search"
            android:maxLines="1"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/btnClearText"
            android:padding="@dimen/metric.8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_input_clear"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <include
        android:id="@+id/vLinearHeaderIndex"
        android:visibility="gone"
        layout="@layout/osms_contact_header_item"/>
    <com.mg.ola.common.widget.IndexableListView
        android:id="@+id/lvContactList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:listSelector="@android:color/transparent"
        android:layout_weight="1"
        style="@style/defaultStyle.list"/>
</LinearLayout>
