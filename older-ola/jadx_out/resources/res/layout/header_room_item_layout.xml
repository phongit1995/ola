<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/translucent_white_80_percent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/commont.list.item.simple.medium">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="@dimen/contact.item.horizon.margin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/txtItemTitle"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="?attr/contact.item.title"/>
        <TextView
            android:textColor="#0681bd"
            android:gravity="center_vertical"
            android:id="@+id/txtItemSubTitle"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="@dimen/metric.4dp"
            style="?attr/contact.item.subTitle"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/imgRoomIcon"
        android:padding="@dimen/contact.item.horizon.pading"
        android:focusable="false"
        android:layout_width="@dimen/contact.item.avatar.size"
        android:layout_height="@dimen/contact.item.avatar.size"
        android:scaleType="centerInside"/>
</LinearLayout>
