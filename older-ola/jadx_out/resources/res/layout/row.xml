<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/row_icon"
        android:padding="@dimen/metric.8dp"
        android:layout_width="@dimen/metric.48dp"
        android:layout_height="@dimen/metric.48dp"
        android:layout_marginLeft="@dimen/metric.8dp"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/row_title"
        android:padding="@dimen/metric.8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <TextView
        android:textColor="@color/colorTextBlackSecondaryOrIcon"
        android:gravity="center"
        android:id="@+id/row_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/metric.8dp"/>
</LinearLayout>
