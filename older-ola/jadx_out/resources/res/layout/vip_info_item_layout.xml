<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/vipIconViewLayout"
    android:background="@color/translucent_white_80_percent"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/metric.72dp">
    <LinearLayout
        android:padding="@dimen/metric.16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/vipIconImageView"
            android:focusable="false"
            android:layout_width="@dimen/metric.40dp"
            android:layout_height="@dimen/metric.40dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/metric.8dp">
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/vipNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/defaultStyle.text.subhead"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/vipStateTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.2dp"
                android:maxLines="1"
                style="@style/defaultStyle.text.caption"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/listViewBottomDividerView"
        android:background="@color/colorTextBlackDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/metric.16dp"
        android:layout_marginRight="@dimen/metric.16dp"/>
</LinearLayout>
