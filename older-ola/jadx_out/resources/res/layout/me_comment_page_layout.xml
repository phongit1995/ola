<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wrapMeComment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v4.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:paddingTop="@dimen/metric.topbar.noshadow.42dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ListView
            android:layout_gravity="center_horizontal"
            android:id="@+id/listView"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/defaultStyle.list.rowSpacing"/>
    </android.support.v4.widget.SwipeRefreshLayout>
    <include layout="@layout/ola_top_action_bar_layout"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:background="@drawable/bg_progress_player"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/defaultStyle.progresswatting"/>
</FrameLayout>
