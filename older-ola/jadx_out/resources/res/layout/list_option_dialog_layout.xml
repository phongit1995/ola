<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearTitle"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric.48dp">
        <TextView
            android:gravity="center"
            android:id="@+id/txtItemTitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/defaultStyle.text.subhead"/>
        <View
            android:background="@color/colorTextBlackDivider"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <ListView
        android:id="@+id/lvListOption"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/metric.sub.4dp"
        android:cacheColorHint="@color/transparent"
        android:layout_weight="1"
        style="?attr/commont.list"/>
    <LinearLayout
        android:id="@+id/linearFooter"
        android:padding="@dimen/metric.4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp">
        <Button
            android:id="@+id/btnButton1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/string_accept"
            android:layout_weight="1"
            style="@style/defaultStyle.button.green"/>
        <Button
            android:id="@+id/btnButton2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/metric.4dp"
            android:text="@string/string_cancel"
            android:layout_weight="1"
            style="?attr/commont.button"/>
    </LinearLayout>
</LinearLayout>
