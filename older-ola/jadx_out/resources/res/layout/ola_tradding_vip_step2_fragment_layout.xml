<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/metric.16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/vipIconImageView"
                android:focusable="false"
                android:layout_width="@dimen/metric.40dp"
                android:layout_height="@dimen/metric.40dp"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/vipTitleTextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/metric.8dp"
                android:layout_weight="1"
                style="?attr/vip.text.item"/>
        </LinearLayout>
        <View
            android:background="@color/colorTextBlackDivider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/metric.8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.16dp"
            android:text="@string/string_nick_receiver"
            style="@style/defaultStyle.text.subhead"/>
        <chat.ola.vn.view.OlaQuickTypingSuggestedText
            android:id="@+id/receiverIdEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/general_hint_remind_receiver_nick"
            android:maxLines="1"
            android:imeOptions="actionNext"
            style="@style/defaultStyle.edittext"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.16dp"
            android:text="@string/string_vip_duration"
            style="@style/defaultStyle.text.subhead"/>
        <EditText
            android:id="@+id/vipDurationEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/general_hint_vip_duration_in_day"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            style="@style/defaultStyle.edittext"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.16dp"
            android:text="@string/string_vip_price"
            style="@style/defaultStyle.text.subhead"/>
        <EditText
            android:id="@+id/kenEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/general_hint_vip_price_in_ken"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            style="@style/defaultStyle.edittext"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.24dp">
            <Button
                android:gravity="center"
                android:id="@+id/editButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.36dp"
                android:layout_marginRight="@dimen/metric.4dp"
                android:text="@string/string_reselect_vip"
                android:layout_weight="1"
                style="@style/defaultStyle.button"/>
            <Button
                android:gravity="center"
                android:id="@+id/nextStepButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.36dp"
                android:layout_marginLeft="@dimen/metric.4dp"
                android:text="@string/string_ok"
                android:layout_weight="1"
                style="@style/defaultStyle.button.green"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
