<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="@dimen/metric.2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/commont.list.item.simple.medium">
    <chat.ola.vn.view.OlaCachedImageView
        android:id="@+id/imgItemIcon"
        android:background="?attr/commont.button.image"
        android:padding="@dimen/metric.4dp"
        android:focusable="false"
        android:layout_width="@dimen/contact.item.avatar.size"
        android:layout_height="@dimen/contact.item.avatar.size"
        android:src="@drawable/smiles_offline"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:cropToPadding="true"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/txtItemTitle"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_weight="1"
        style="?attr/menu.item.text.style"/>
    <TextView
        android:gravity="center"
        android:id="@+id/txtUnreadMessgage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        style="?attr/commont.text.unread"/>
    <CheckBox
        android:id="@+id/ckbItemSelect"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="?attr/commont.checkbox.button"/>
</LinearLayout>
