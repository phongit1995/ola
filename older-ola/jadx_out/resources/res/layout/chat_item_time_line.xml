<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/metric.16dp"
    android:paddingBottom="@dimen/metric.16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_vertical"
        android:background="@color/colorTextBlackDivider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_time_line"
        android:paddingLeft="@dimen/metric.8dp"
        android:paddingTop="@dimen/metric.4dp"
        android:paddingRight="@dimen/metric.8dp"
        android:paddingBottom="@dimen/metric.4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text.size.caption"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/messageTimeText"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/metric.2dp"/>
    </FrameLayout>
    <View
        android:layout_gravity="center_vertical"
        android:background="@color/colorTextBlackDivider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_weight="1"/>
</LinearLayout>
