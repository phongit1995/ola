<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/translucent_white_80_percent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/commont.list.item.simple.medium">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <chat.ola.vn.view.OlaCachedImageView
            android:id="@+id/imgAlbumThumbnail"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="@dimen/contact.item.attach.photo.size"
            android:layout_height="@dimen/contact.item.attach.photo.size"
            android:scaleType="fitCenter"
            android:cropToPadding="true"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/imgAlbumPrivacyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/metric.4dp"
            android:scaleType="centerInside"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/metric.8dp"
        android:layout_weight="1">
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/txtAlbumTitle"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="?attr/contact.item.title"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/txtAlbumCreatedDate"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="?attr/contact.item.subTitle"/>
    </LinearLayout>
    <TextView
        android:id="@+id/txtNumOfMedia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/metric.8dp"/>
</LinearLayout>
