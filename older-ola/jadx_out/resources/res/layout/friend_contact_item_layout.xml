<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/meContentView"
        android:background="@drawable/bg_shadow_4_edges"
        android:padding="@dimen/metric.8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/metric.8dp"
        android:layout_marginTop="@dimen/metric.8dp"
        android:layout_marginRight="@dimen/metric.8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <chat.ola.vn.view.OlaCachedImageView
                android:id="@+id/imgContactPhoto"
                android:layout_width="@dimen/metric.40dp"
                android:layout_height="@dimen/metric.40dp"
                android:src="@drawable/ic_contact_photo"
                android:scaleType="centerCrop"
                android:cropToPadding="true"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/txtNickOla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/metric.8dp"
                android:maxLines="1"
                style="@style/defaultStyle.text.subhead"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.4dp">
            <Button
                android:id="@+id/btnViewMe"
                android:background="@drawable/btn_default_button_selector"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.32dp"
                android:text="@string/string_view_me"
                android:layout_weight="1"
                style="?attr/me.item.button"/>
            <Button
                android:id="@+id/btnStartChat"
                android:background="@drawable/btn_default_button_selector"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.32dp"
                android:layout_marginLeft="@dimen/metric.16dp"
                android:text="@string/string_chat"
                android:layout_weight="1"
                style="?attr/me.item.button"/>
            <Button
                android:id="@+id/btnMakeFriend"
                android:background="@drawable/btn_default_button_selector"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.32dp"
                android:layout_marginLeft="@dimen/metric.16dp"
                android:text="@string/string_make_friend"
                android:layout_weight="1"
                style="?attr/me.item.button"/>
            <Button
                android:ellipsize="end"
                android:id="@+id/btnUnfollow"
                android:background="@drawable/btn_default_button_selector"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.32dp"
                android:layout_marginLeft="@dimen/metric.16dp"
                android:text="@string/string_notfollow"
                android:maxLines="1"
                android:layout_weight="1"
                style="?attr/me.item.button"/>
            <Button
                android:ellipsize="end"
                android:id="@+id/btnBlockMe"
                android:background="@drawable/btn_default_button_selector"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/metric.32dp"
                android:layout_marginLeft="@dimen/metric.16dp"
                android:text="@string/string_block"
                android:maxLines="1"
                android:layout_weight="1"
                style="?attr/me.item.button"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
