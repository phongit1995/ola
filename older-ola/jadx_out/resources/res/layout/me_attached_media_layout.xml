<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/thumbnailSpan"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <chat.ola.vn.view.OlaRatioImageView
            android:id="@+id/mediaImageView1"
            android:background="@drawable/bg_shadown_border_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:cropToPadding="true"
            android:layout_weight="1"/>
        <chat.ola.vn.view.OlaRatioImageView
            android:id="@+id/mediaImageView2"
            android:background="@drawable/bg_shadown_border_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:cropToPadding="true"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <chat.ola.vn.view.OlaRatioImageView
            android:id="@+id/mediaImageView3"
            android:background="@drawable/bg_shadown_border_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:cropToPadding="true"
            android:layout_weight="1"/>
        <chat.ola.vn.view.OlaSquareCachedImageView
            android:id="@+id/mediaImageView4"
            android:background="@drawable/bg_shadown_border_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:cropToPadding="true"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/theTenViewLayout"
            android:background="@drawable/bg_shadown_border_small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <chat.ola.vn.view.OlaSquareCachedImageView
                android:id="@+id/mediaImageView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:cropToPadding="true"/>
            <TextView
                android:textSize="@dimen/text.size.32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="bottom|right"
                android:id="@+id/moreMediaTextView"
                android:background="@color/translucent_black_60_percent"
                android:padding="@dimen/metric.8dp"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
