<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="2dp"
    android:paddingTop="@dimen/metric.4dp"
    android:paddingRight="@dimen/metric.4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/linearMallItemTabSpan"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/btnMallItemDetailActionComment"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            style="?attr/actionBar.tab.button">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_button_stroke_comment"
                android:scaleType="centerInside"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/txtMallItemDetailCommentNumber"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:drawablePadding="0dp"
                style="?attr/me.text.like"/>
        </LinearLayout>
        <TextView
            android:id="@+id/btnMallItemTabPlaylist"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/string_chap"
            style="?attr/actionBar.tab.button"/>
        <TextView
            android:id="@+id/btnMallItemTabVideo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/string_concern"
            style="?attr/actionBar.tab.button"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/btnMallItemShare"
        android:padding="@dimen/metric.2dp"
        android:layout_width="@dimen/general.list.item.height.small"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/metric.4dp"
        android:src="@drawable/ic_button_stroke_share"
        android:scaleType="centerInside"
        android:minWidth="@dimen/metric.36dp"
        style="?attr/commont.button.image"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/btnMallItemDetailLike"
        android:background="@drawable/btn_default_noborder_button_selector"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/metric.32dp"
        android:layout_marginLeft="@dimen/metric.2dp"
        android:layout_marginBottom="@dimen/metric.4dp">
        <ImageView
            android:id="@+id/imgMallItemDetailLikeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_button_stroke_like"
            android:scaleType="centerInside"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/txtMallItemDetailLikeNumber"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:drawablePadding="0dp"
            style="?attr/me.text.like"/>
    </LinearLayout>
</LinearLayout>
