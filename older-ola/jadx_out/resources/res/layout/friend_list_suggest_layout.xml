<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/lvFriendSuggest"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/general.actionbar.shadow.height"
        android:cacheColorHint="@color/transparent"
        android:dividerHeight="0dp"
        android:layout_below="@+id/linearWrap"
        style="?attr/commont.list"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linearWrap"
        android:layout_width="match_parent"
        style="@style/defaultStyle.actionBar.background">
        <ImageView
            android:id="@+id/btnActionButtonLeft"
            android:layout_width="@dimen/metric.48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_action_back"
            style="?attr/actionBar.button"/>
        <chat.ola.vn.view.AutoScrollTextView
            android:gravity="center"
            android:id="@+id/txtActionTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/metric.48dp"
            android:text="@string/message_found_friend"
            android:layout_weight="1"
            style="?attr/actionBar.title"/>
    </LinearLayout>
</RelativeLayout>
