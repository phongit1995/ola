<?xml version="1.0" encoding="utf-8"?>
<com.mg.ola.common.widget.SoftKeyLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        style="@style/defaultStyle.actionBar.background">
        <ImageView
            android:id="@+id/actionButtonBack"
            android:layout_width="@dimen/metric.36dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_action_back"
            style="?attr/actionBar.button"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <EditText
                android:gravity="bottom|left"
                android:id="@+id/txtFilterInput"
                android:background="@drawable/textfield_action_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/general_hint_nick"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:imeOptions="actionSend"
                style="?attr/common.editText"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/btnInputClear"
                android:padding="@dimen/metric.4dp"
                android:layout_width="@dimen/metric.36dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_input_clear"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/actionButtonOption"
            android:layout_width="@dimen/metric.36dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_more_white"
            style="?attr/actionBar.button"/>
    </LinearLayout>
    <com.mg.ola.common.widget.IndexableListView
        android:id="@+id/lvContact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fastScrollEnabled="true"
        style="?attr/commont.list"/>
</com.mg.ola.common.widget.SoftKeyLinearLayout>
