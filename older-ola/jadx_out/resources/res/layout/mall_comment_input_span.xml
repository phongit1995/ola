<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/linearMallCommentSpan"
        android:background="@drawable/bg_me_comment_top_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/metric.8dp"
        android:layout_marginTop="0dp"
        android:layout_marginRight="@dimen/metric.8dp"
        android:minHeight="@dimen/metric.72dp">
        <chat.ola.vn.view.OlaCachedImageView
            android:id="@+id/imgMallItemAvatar"
            android:layout_width="@dimen/metric.40dp"
            android:layout_height="@dimen/metric.40dp"
            android:layout_margin="@dimen/metric.4dp"
            android:src="@drawable/ic_contact_photo"
            android:scaleType="fitCenter"/>
        <EditText
            android:gravity="bottom"
            android:id="@+id/txtMallSearchInput"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.4dp"
            android:layout_marginRight="@dimen/metric.4dp"
            android:hint="@string/general_hint_comment_quick"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionSend"
            style="@style/defaultStyle.edittext"/>
    </LinearLayout>
</LinearLayout>
