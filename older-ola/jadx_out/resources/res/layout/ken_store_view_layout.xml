<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scrollView1"
        android:paddingTop="@dimen/metric.topbar.noshadow.42dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/red"
                android:id="@+id/kenNotify"
                android:background="@drawable/bg_form_content_span"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/metric.8dp"
                android:maxLines="5"
                style="@style/defaultStyle.text.small"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/traddingLayout"
                    android:background="@drawable/bg_form_content_span"
                    android:padding="@dimen/metric.8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:showDividers="middle">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="?attr/form.header">
                        <TextView
                            android:gravity="center"
                            android:id="@+id/textView1"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/string_ballance"
                            style="?attr/vip.text.button.tranfer.text.lable"/>
                        <TextView
                            android:id="@+id/txtKenAvaliable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/metric.4dp"
                            android:layout_weight="1"
                            style="?attr/vip.text.button.tranfer.text.value"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/buyKENButton"
                        android:paddingLeft="@dimen/metric.8dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/metric.36dp"
                        android:text="@string/string_purchase_ken"
                        style="?attr/vip.text.button.tranfer.item"/>
                    <View
                        android:background="@color/colorTextBlackDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="@dimen/metric.8dp"
                        android:layout_marginRight="@dimen/metric.8dp"/>
                    <Button
                        android:id="@+id/btnTraddingTransferKen"
                        android:paddingLeft="@dimen/metric.8dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/metric.36dp"
                        android:text="@string/string_transfer_ken"
                        style="?attr/vip.text.button.tranfer.item"/>
                    <View
                        android:background="@color/colorTextBlackDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginLeft="@dimen/metric.8dp"
                        android:layout_marginRight="@dimen/metric.8dp"/>
                    <Button
                        android:id="@+id/btnTraddingHistory"
                        android:paddingLeft="@dimen/metric.8dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/metric.36dp"
                        android:text="@string/string_tradding_history"
                        style="?attr/vip.text.button.tranfer.item"/>
                </LinearLayout>
                <Button
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btnSupportService"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/metric.36dp"
                    android:layout_margin="@dimen/metric.8dp"
                    android:text="@string/string_customer_support"
                    style="@style/defaultStyle.button.green"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/ola_top_icon_action_bar_layout"/>
</FrameLayout>
