<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/linearEditWrapper"
    android:background="#d6d6d6"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linearWrap"
        android:layout_width="match_parent"
        style="@style/defaultStyle.actionBar.background">
        <LinearLayout
            android:id="@+id/btnActionButtonLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/metric.4dp"
                android:layout_marginTop="@dimen/metric.16dp"
                android:layout_marginBottom="@dimen/metric.16dp"
                android:src="@drawable/ic_action_back"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/metric.4dp"
                android:layout_marginTop="@dimen/metric.8dp"
                android:layout_marginBottom="@dimen/metric.8dp"
                android:src="@drawable/ola_logo_trans"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <chat.ola.vn.view.AutoScrollTextView
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/txtActionTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/metric.8dp"
            android:layout_marginRight="@dimen/metric.8dp"
            android:text="@string/string_send_marry_request"
            android:layout_weight="1"
            style="?attr/actionBar.title"/>
        <ImageView
            android:id="@+id/btnActionButtonRight"
            android:layout_width="@dimen/metric.48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_action_send"
            android:text="@string/string_send"
            style="?attr/actionBar.button"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollView1"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/metric.8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <chat.ola.vn.view.OlaQuickTypingSuggestedText
                android:id="@+id/receiverId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/metric.4dp"
                android:layout_marginTop="@dimen/metric.8dp"
                android:layout_marginRight="@dimen/metric.4dp"
                android:layout_marginBottom="@dimen/metric.8dp"
                android:hint="@string/message_receiver_id_not_null"
                android:maxLines="1"
                android:dropDownAnchor="@+id/receiverAnchor"
                android:imeOptions="actionNext"
                style="@style/defaultStyle.edittext.username"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/bg_shadow_4_edges"
                android:padding="@dimen/metric.4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imgKulView"
                    android:background="@drawable/btn_transparent_image_selector"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="@dimen/general.icon.kul.message.size"
                    android:layout_height="@dimen/general.icon.kul.message.size"
                    android:src="@drawable/kul01"
                    android:scaleType="centerInside"/>
                <chat.ola.vn.view.OlaTypingSuggestedText
                    android:gravity="top|left"
                    android:id="@+id/txtEditMe"
                    android:background="@drawable/bg_edit_text_border"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/message_marriage_request_message_not_null"
                    android:minLines="5"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1"
                    android:inputType="textNoSuggestions"
                    style="@style/defaultStyle.text.body1"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
