<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/metric.16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/metric.topbar.noshadow.42dp">
        <EditText
            android:id="@+id/quickReplyEditText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.8dp"
            android:hint="@string/string_type_quick_message"
            style="@style/defaultStyle.edittext"/>
        <EditText
            android:id="@+id/quickReplyEditText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.8dp"
            android:hint="@string/string_type_quick_message"
            style="@style/defaultStyle.edittext"/>
        <EditText
            android:id="@+id/quickReplyEditText3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.8dp"
            android:hint="@string/string_type_quick_message"
            style="@style/defaultStyle.edittext"/>
    </LinearLayout>
    <include layout="@layout/ola_top_action_bar_layout"/>
</FrameLayout>
