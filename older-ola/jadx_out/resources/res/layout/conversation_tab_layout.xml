<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <it.sephiroth.android.library.widget.EnhancedListView
        android:id="@+id/conversationListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/defaultStyle.list.noDivider"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/conversationTipLayout"
        android:background="@color/white"
        android:padding="@dimen/metric.16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:gravity="left"
            android:layout_gravity="center"
            android:id="@+id/conversationTipTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.16dp"
            android:text="@string/message_free_chat"
            style="@style/defaultStyle.text.subhead"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/metric.16dp"
            android:text="@string/message_make_friend_by_chat"
            style="@style/defaultStyle.text.body1"/>
    </LinearLayout>
    <ImageButton
        android:id="@+id/addConversationImageButton"
        android:background="@drawable/floating_action_bar_shape"
        android:padding="@dimen/metric.16dp"
        android:layout_width="@dimen/metric.56dp"
        android:layout_height="@dimen/metric.56dp"
        android:layout_marginRight="@dimen/metric.16dp"
        android:layout_marginBottom="@dimen/metric.16dp"
        android:src="@drawable/ic_action_compose_message"
        android:scaleType="centerInside"
        android:tint="@android:color/white"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
