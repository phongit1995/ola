<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:state_pressed="false">
        <shape>
            <corners android:radius="10.0dp" />
            <gradient android:startColor="#80ac38" android:endColor="#d6e4bf" android:angle="90.0" />
            <padding android:left="@dimen/metric.2dp" android:top="@dimen/metric.2dp" android:right="@dimen/metric.2dp" android:bottom="@dimen/metric.2dp" />
            <stroke android:width="1.0px" android:color="#9ec85a" />
        </shape>
    </item>
    <item android:state_focused="false" android:state_pressed="true">
        <shape>
            <corners android:radius="10.0dp" />
            <gradient android:startColor="#80ac38" android:endColor="#d6e4bf" android:angle="270.0" />
            <padding android:left="@dimen/metric.2dp" android:top="@dimen/metric.2dp" android:right="@dimen/metric.2dp" android:bottom="@dimen/metric.2dp" />
            <stroke android:width="1.0px" android:color="#9ec85a" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_pressed="false">
        <shape>
            <corners android:radius="10.0dp" />
            <gradient android:startColor="#80ac38" android:endColor="#d6e4bf" android:angle="90.0" />
            <padding android:left="@dimen/metric.2dp" android:top="@dimen/metric.2dp" android:right="@dimen/metric.2dp" android:bottom="@dimen/metric.2dp" />
            <stroke android:width="2.0px" android:color="#9ec85a" />
        </shape>
    </item>
</selector>
